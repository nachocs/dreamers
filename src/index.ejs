<!DOCTYPE html>
<!--[if lt IE 7 ]> <html lang="es" class="ie6" <% if(htmlWebpackPlugin.files.manifest) { %> manifest="<%= htmlWebpackPlugin.files.manifest %>"<% } %>> <![endif]-->
<!--[if IE 7 ]>    <html lang="es" class="ie7" <% if(htmlWebpackPlugin.files.manifest) { %> manifest="<%= htmlWebpackPlugin.files.manifest %>"<% } %>> <![endif]-->
<!--[if IE 8 ]>    <html lang="es" class="ie8" <% if(htmlWebpackPlugin.files.manifest) { %> manifest="<%= htmlWebpackPlugin.files.manifest %>"<% } %>> <![endif]-->
<!--[if IE 9 ]>    <html lang="es" class="ie9" <% if(htmlWebpackPlugin.files.manifest) { %> manifest="<%= htmlWebpackPlugin.files.manifest %>"<% } %>> <![endif]-->
<!--[if (gt IE 9)|!(IE)]><!--> <html lang="es" class="" <% if(htmlWebpackPlugin.files.manifest) { %> manifest="<%= htmlWebpackPlugin.files.manifest %>"<% } %>> <!--<![endif]-->
<head>
  <meta charset="utf-8">
  <title><%= htmlWebpackPlugin.options.title || 'Webpack App'%></title>
  <meta name="description" content="<%= htmlWebpackPlugin.options.description %>">
  <link rel="canonical" href="https://dreamers.es/">

  <!-- La app es un SPA de Backbone: pinta #root vacio, baja y ejecuta el
       bundle, y SOLO ENTONCES pide este feed. Bajo latencia movil eso es
       una cadena serial larga. La URL del feed inicial es siempre esta
       misma (indice y empieza arrancan vacios, ver entradaCollection.js),
       asi que se puede precargar en paralelo a la descarga del JS. -->
  <link rel="preload" href="https://dreamers.es/com/home2/cgi/json.cgi?indice=&empieza=" as="fetch" crossorigin="anonymous">

  <!-- El elemento LCP real de la portada es un fondo CSS
       (background-image, no <img>) que sirve tienda.dreamers.es dentro de
       la primera tarjeta de "novedades tienda". Al ser un background-image
       inyectado por JS, el navegador no puede ni descubrirlo ni empezar a
       conectar a ese origen hasta que la app arranca; comprobado con
       Lighthouse (lcp-breakdown-insight): 979ms de "resource load delay"
       antes de que empiece siquiera la peticion. Esto adelanta al menos el
       DNS+TCP+TLS. -->
  <link rel="preconnect" href="https://tienda.dreamers.es">

  <% if (htmlWebpackPlugin.files.favicon) { %>
  <link rel="shortcut icon" href="<%= htmlWebpackPlugin.files.favicon%>">
  <% } %>

  <% if (htmlWebpackPlugin.options.manifest) { %>
  <link rel="manifest" href="<%= htmlWebpackPlugin.options.manifest%>">
  <% } %>

  <% if (htmlWebpackPlugin.options.mobileIcons) { %>
    <link rel="apple-touch-icon" sizes="57x57" href="/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192"  href="/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
  <% } %>

  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Dreamers">
  <meta property="og:locale" content="es_ES">
  <meta property="og:title" content="<%= htmlWebpackPlugin.options.title %>">
  <meta property="og:description" content="<%= htmlWebpackPlugin.options.description %>">
  <meta property="og:url" content="https://dreamers.es/">
  <!-- og:image apuntaba a apple-icon-180x180.png, que ademas de ser cuadrado
       y de solo 180px daba 404 en produccion (src/assets/ no se copiaba al
       desplegar), asi que al compartir un enlace no salia imagen ninguna.
       Ahora es una de 1200x630, la proporcion que piden Facebook, WhatsApp,
       Twitter y LinkedIn, hecha con el trazado original del logo. Las
       medidas explicitas evitan que la primera vez que se comparte el
       enlace salga sin imagen mientras el scraper la descarga. -->
  <meta property="og:image" content="https://dreamers.es/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:alt" content="Dreamers">
  <!-- summary_large_image y no summary: con 1200x630 corresponde la tarjeta
       grande; 'summary' la recortaria a un cuadrado pequeno. -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https://dreamers.es/og-image.png">

  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"WebSite","name":"Dreamers","url":"https://dreamers.es/"}
  </script>
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"Organization","name":"Dreamers","url":"https://dreamers.es/","logo":"https://dreamers.es/android-icon-192x192.png"}
  </script>



  <% if (htmlWebpackPlugin.options.baseHref) { %>
  <base href="<%= htmlWebpackPlugin.options.baseHref %>" />
  <% } %>

  <!-- This script should contain the messages that should be used by the app.
       In the development environment, this is proxied by webpack-dev-server in the /../webpack/webpack.dev.server.js file.
       Look for the `proxy` key and this address. -->
  <% if (htmlWebpackPlugin.options.messagesPath) { %>
  <script src="<%= htmlWebpackPlugin.options.messagesPath%>"></script>
  <% } %>

  <!-- Sin preconnect el navegador no abre la conexion (DNS+TCP+TLS) a estos
       dos origenes hasta que lee el <link> mas abajo; con RTT movil eso son
       rondas enteras perdidas antes de que empiece a bajar la fuente. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Material Design Lite is now bundled from node_modules (see webpack entry.app) instead of
       storage.googleapis.com/code.getmdl.io, which Google permanently shut down (~June 2026). -->
  <!-- Se quitan las dos hojas de slick-carousel: apuntaban a
       //cdn.jsdelivr.net/jquery.slick/1.6.0/, una ruta del CDN antiguo de
       jsDelivr que ya no existe, y ademas el carrusel no se usa en ningun
       sitio del codigo (la dependencia tambien se ha retirado). -->
  <!-- Estas dos hojas eran render-blocking: Lighthouse las marcaba con
       926ms y 200ms de bloqueo cada una pese a pesar menos de 3KB, solo por
       ser cross-origin. Se cargan ahora con el patron loadCSS (preload +
       onload cambia el rel a stylesheet): el navegador sigue pintando sin
       esperarlas. OJO, esto NO es font-display (eso rompio la fuente de
       marca en tienda.dreamers.es, ver memoria) - aqui solo se retrasa
       CUANDO se aplica la hoja, no como se comporta la fuente al llegar.
       El unico efecto visible es el icono "material-icons" del boton de
       la cabecera (power_settings_new) mostrando su texto en crudo un
       instante hasta que carga; probado visualmente antes de desplegar. -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/icon?family=Material+Icons" onload="this.onload=null;this.rel='stylesheet'">
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css?family=Montserrat|Open+Sans" onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Montserrat|Open+Sans">
  </noscript>
  <% for (var css in htmlWebpackPlugin.files.css) { %>
  <link href="<%= htmlWebpackPlugin.files.css[css] %>" rel="stylesheet">
  <% } %>
</head>
<body>
  <% if (htmlWebpackPlugin.options.appMountId) { %>
  <div id="<%= htmlWebpackPlugin.options.appMountId%>"></div>
  <% } %>

  <% if (htmlWebpackPlugin.options.window) { %>
  <script>
    <% for (var varName in htmlWebpackPlugin.options.window) { %>
      window['<%=varName%>'] = <%= JSON.stringify(htmlWebpackPlugin.options.window[varName]) %>;
    <% } %>
  </script>
  <% } %>

  <% if (htmlWebpackPlugin.options.unsupportedBrowser) { %>
    <script>
      var $buoop = {
        vs:{i:11,f:-4,o:-4,s:7},
        mobile: false,
        c:4,
        reminder: 24,
        reminderClosed: 150
      };
      function $buo_f(){
       var e = document.createElement("script");
       e.src = "//browser-update.org/update.min.js";
       document.body.appendChild(e);
      };
      try {document.addEventListener("DOMContentLoaded", $buo_f,false)}
      catch(e){window.attachEvent("onload", $buo_f)}
    </script>
  <% } %>

  <!-- html-webpack-plugin 5 elimino 'files.chunks'; ahora los bundles de
       JS vienen en 'files.js', ya como lista de rutas. -->
  <% for (var i = 0; i < htmlWebpackPlugin.files.js.length; i++) { %>
  <script src="<%= htmlWebpackPlugin.files.js[i] %>" crossorigin="anonymous"></script>
  <% } %>
<!-- Navegacion para clientes sin JavaScript y para los rastreadores. La app
     monta su contenido por AJAX en #root, asi que sin esto el HTML de la
     portada solo contiene DOS enlaces y ningun buscador puede llegar desde
     aqui a las secciones. Son las mismas URLs que sirve el motor Indices,
     verificadas una a una: no hay nada oculto ni distinto de lo que ve un
     visitante. Se enlaza 'news' y no 'noticias', y 'destacados' y no
     'redaccion', porque cada par sirve el mismo contenido en dos URLs. -->
<noscript>
  <nav>
    <h1>Dreamers</h1>
    <ul>
      <li><a href="/comics/">C&oacute;mics</a></li>
      <li><a href="/peliculas/">Pel&iacute;culas</a></li>
      <li><a href="/series/">Series</a></li>
      <li><a href="/libros/">Libros</a></li>
      <li><a href="/discos/">Discos</a></li>
      <li><a href="/videojuegos/">Videojuegos</a></li>
      <li><a href="/news/">Noticias</a></li>
      <li><a href="/articulos/">Art&iacute;culos</a></li>
      <li><a href="/relatos/">Relatos</a></li>
      <li><a href="/autores/">Autores</a></li>
      <li><a href="/personajes/">Personajes</a></li>
      <li><a href="/destacados/">Destacados</a></li>
      <li><a href="/webcomics/">Webc&oacute;mics</a></li>
      <li><a href="/advance/">Advance</a></li>
      <li><a href="/lanzamientos/">Lanzamientos</a></li>
      <li><a href="/promociones/">Promociones</a></li>
      <li><a href="/tebelogs/">Tebelogs</a></li>
      <li><a href="/ciudad/">La Ciudad</a></li>
      <li><a href="/galeria/">Galer&iacute;a</a></li>
      <li><a href="/postales/">Postales</a></li>
      <li><a href="https://tienda.dreamers.es">Tienda</a></li>
      <li><a href="/indexclasico.html">Web Cl&aacute;sica</a></li>
    </ul>
  </nav>
</noscript>
<div style="position: absolute; top: 75px; left: 12px; z-index: 4;"><a
    href="https://tienda.dreamers.es">Tienda</a></div>
<div style="position: absolute; top: 75px; right: 12px; z-index: 2;"><a
    href="https://dreamers.es/indexclasico.html">Web Cl&aacute;sica</a></div>
</body>
</html>
