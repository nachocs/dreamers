# TODO el script va dentro de estas llaves, y termina en 'exit'. No es
# cosmetico: mas abajo se hace 'git pull', y ese pull puede REESCRIBIR este
# mismo fichero mientras se esta ejecutando. La shell lee el script por
# trozos, guardandose un desplazamiento en bytes; si el fichero cambia de
# tamano a mitad, lo que lee despues queda desalineado y ejecuta basura.
# Metiendolo todo en un comando compuesto, la shell tiene que leerlo entero
# ANTES de ejecutar nada, y el 'exit' final garantiza que no vuelva al
# fichero. Sin esto, cualquier commit que toque 'update' es una ruleta.
{
set -x;
cd /home/dreamers/git/dreamers;
# npm install reescribe package-lock.json en cada pasada, asi que el checkout
# de despliegue queda siempre sucio. En cuanto un commit toca el lock, el pull
# aborta con "Los cambios locales seran sobrescritos" y -- como abajo va ';' y
# no '&&' -- el script sigue y reconstruye el codigo VIEJO sin avisar. Eso ya
# paso el 2026-08-06 con el fichero 'update' (por el bit de ejecucion) y dejo
# el servidor clavado en un commit antiguo durante dos despliegues seguidos.
# Se descarta la reescritura local del lock antes de tirar: aqui es un
# subproducto de npm, nunca un cambio que alguien quiera conservar.
git checkout -- package-lock.json 2>/dev/null;
git pull;
# Ya NO hace falta --legacy-peer-deps: lo pedia extract-text-webpack-plugin
# @2.1.2, que exigia webpack ^2.2.0 mientras el proyecto usaba webpack 3, y
# npm 7+ trata ese choque de peer deps como error fatal (ERESOLVE). Al pasar
# a webpack 5 ese plugin desaparecio (lo sustituye mini-css-extract-plugin) y
# el arbol resuelve limpio. Si algun dia vuelve a hacer falta el flag, es
# senal de que se ha colado una dependencia incompatible: mejor arreglarla
# que tapar el aviso.
# 'npm ci' seria lo suyo aqui, pero necesita que el lock este siempre en
# sintonia exacta con package.json; se deja 'npm install' para no cambiar
# dos cosas a la vez.
# src/assets/ NO lo copia webpack: en dist solo entra lo que pasa por el
# bundle, mas el favicon. Por eso los 7 iconos que declara el <head>
# (apple-icon-*, favicon-*, ms-icon-*, android-icon-*) daban 404 en
# produccion, y con ellos la og:image -- o sea que al compartir un enlace
# de dreamers.es no salia imagen ninguna. Comprobado el 2026-08-06.
# Se copian ANTES que dist para que, si algo coincide de nombre, mande lo
# generado por el build: manifest.json lo produce WebpackAssetsManifest y
# es el que tiene que ganar, no la copia estatica de src/assets/.
#
# Y se copian DOS VECES, a la raiz y a www/assets/, porque en el sitio
# conviven dos convenciones de ruta y hasta hoy solo se atendia una:
#   - los iconos del <head> (apple-icon-*, favicon-*, ms-icon-*) se piden
#     desde la RAIZ: href="/apple-icon-180x180.png"
#   - los iconos y las capturas del MANIFEST se piden desde /assets/:
#     "src": "/assets/android-icon-512x512.png"
# Por eso los android-icon de 256, 384 y 512 daban 404 en Chrome aunque
# estuvieran declarados en el manifest: nadie los subia a assets/. Estaban
# ahi de milagro los seis pequenos, copiados a mano en algun momento.
# Comprobado el 2026-08-19.
mkdir -p ../../www/assets;
npm install && npm run build && cp -R src/assets/* ../../www/ && cp -R src/assets/* ../../www/assets/ && cp -R dist/* ../../www/ || {
    echo "!! El despliegue ha fallado. NO se limpia nada.";
    exit 1;
};

# ---------------------------------------------------------------------------
# Limpieza de ficheros huerfanos del build
#
# Los bundles llevan el hash del contenido en el nombre
# (app.<hash>.js/.css), asi que cada despliegue deja en el servidor los del
# despliegue anterior, para siempre: 'cp' copia, nunca borra. El 2026-08-23
# habia 8 bundles JS y 5 CSS de la misma version conviviendo, mas la fuente
# de Font Awesome ya retirada, 49 MB en total. Nadie los pide (el index.html
# solo nombra los del ultimo build), pero se acumulan sin fin.
#
# ATENCION AL ALCANCE. Lo unico que este script puede borrar sin peligro es
# el directorio de la version ACTUAL dentro de www/dist/, porque ese lo
# genera el build entero en cada pasada. NO se toca:
#   - www/          -> es el DocumentRoot del sitio: ahi vive todo el
#                      dreamers.es de Perl (indices/, web1/, foros/, ciudad/,
#                      counter/...). Un --delete ahi se lleva el sitio.
#   - www/assets/   -> comparte sitio con ficheros subidos a mano.
#   - www/dist/     -> a este nivel cuelgan las OTRAS versiones (1.0.0 ...
#                      1.0.14). Se dejan a proposito: borrarlas es una
#                      decision aparte, no algo que deba pasar solo.
# ---------------------------------------------------------------------------
VER=$(node -p "require('./package.json').version" 2>/dev/null);
SRC="dist/dist/$VER";
DST="../../www/dist/$VER";

# Guarda 1: la version tiene que ser una version. Si 'node -p' fallara, VER
# quedaria vacio y el destino seria '../../www/dist//' -- con --delete eso
# borraria TODAS las versiones de golpe.
echo "$VER" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$' || {
    echo "!! Version '$VER' no valida: no se limpia nada.";
    exit 1;
};

# Guarda 2: el origen tiene que parecer un build de verdad. Si el build
# hubiera dejado el directorio vacio o a medias, sincronizar con --delete
# vaciaria produccion.
if [ -d "$SRC" ] && ls "$SRC"/app.*.js >/dev/null 2>&1 && ls "$SRC"/app.*.css >/dev/null 2>&1; then
    # -a preserva permisos y fechas, --delete quita del destino lo que ya no
    # existe en el build, -v para que quede en el log QUE se ha borrado.
    rsync -a --delete -v "$SRC/" "$DST/";
else
    echo "!! $SRC no parece un build valido (sin app.*.js / app.*.css): no se limpia nada.";
    exit 1;
fi;

# Informativo: las versiones viejas siguen ocupando sitio. No se borran solas.
echo "--- Otras versiones en www/dist (NO se tocan, borrar a mano si procede) ---";
du -sh ../../www/dist/*/ 2>/dev/null | grep -v "/$VER/$";

exit 0;
}
